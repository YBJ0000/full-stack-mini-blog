generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id         Int       @id @default(autoincrement())
  title      String
  content    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  author     User?     @relation(fields: [authorId], references: [id])
  authorId   Int?

  @@map("posts")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  created_at DateTime @default(now()) @db.Timestamp(6)
  posts      Post[]

  @@map("users")
}
